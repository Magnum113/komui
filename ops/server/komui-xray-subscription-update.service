[Unit]
Description=Refresh KOMUI Xray from the v2RayTun subscription
Documentation=file:/usr/local/sbin/komui-xray-subscription-update
Wants=network-online.target xray.service
After=network-online.target xray.service

[Service]
Type=oneshot
User=root
Group=root
LoadCredential=subscription.url:/etc/komui-xray/subscription.url
LoadCredential=subscription-secondary.url:/etc/komui-xray/subscription-secondary.url
LoadCredential=subscription.hwid:/etc/komui-xray/subscription.hwid
ExecStart=/usr/local/sbin/komui-xray-subscription-update
TimeoutStartSec=40min
UMask=0077

RuntimeDirectory=komui-xray-subscription
RuntimeDirectoryMode=0750
StateDirectory=komui/xray-subscription
StateDirectoryMode=0700

PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/usr/local/etc/xray

[Install]
WantedBy=multi-user.target
