server {
    listen 80;
    listen [::]:80;
    server_name api.komui.ru;

    return 308 https://api.komui.ru$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.komui.ru;

    ssl_certificate /etc/letsencrypt/live/api.komui.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.komui.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    access_log /var/log/nginx/api.komui.retired.access.log;
    error_log /var/log/nginx/api.komui.retired.error.log warn;

    location / {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 410 '{"error":"gone","message":"Legacy API retired"}\n';
    }
}
