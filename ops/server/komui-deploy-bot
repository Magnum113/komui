def handle_update(update: dict[str, Any]) -> None:
    if not is_allowed_chat(update):
        callback = update.get("callback_query") or {}
        if callback.get("id"):
            answer_callback(callback["id"], "Not allowed")
        return

    if "message" in update:
        text = str(update["message"].get("text") or "").strip()
        command = text.split("@", 1)[0] if text.startswith("/") else text
        if command in ("/start", "/deploy", "/menu"):
            send_message("Управление релизами KOMUI и GetoMerch. Выберите действие:", keyboard())
        elif command in ("/status", STATUS_BUTTON):
            handle_status()
        elif command in ("/deploy_stage", STAGE_BUTTON):
            handle_deploy("stage")
        elif command in ("/deploy_prod", PROD_BUTTON):
            request_confirmation("deploy:prod")
        elif command in ("/admin_deploy", ADMIN_DEPLOY_BUTTON):
            request_confirmation("admin:deploy:prod")
        elif command in ("/admin_status", ADMIN_STATUS_BUTTON):
            handle_admin_status()
        elif command in ("/admin_rollback", ADMIN_ROLLBACK_BUTTON):
            request_confirmation("admin:rollback:prod")
        return

    callback = update.get("callback_query") or {}
    data = str(callback.get("data") or "")
    callback_id = str(callback.get("id") or "")
    if data == "status":
        answer_callback(callback_id, "Проверяю статус")
        handle_status()
    elif data == "deploy:stage":
        answer_callback(callback_id, "Релиз stage запущен")
        handle_deploy("stage")
    elif data == "deploy:prod":
        answer_callback(callback_id, "Требуется подтверждение")
        request_confirmation("deploy:prod")
    elif data == "admin:deploy:prod":
        answer_callback(callback_id, "Требуется подтверждение")
        request_confirmation("admin:deploy:prod")
    elif data == "admin:status:prod":
        answer_callback(callback_id, "Проверяю админку")
        handle_admin_status()
    elif data == "admin:rollback:prod":
        answer_callback(callback_id, "Требуется подтверждение")
        request_confirmation("admin:rollback:prod")
    elif data == "confirm:cancel":
        answer_callback(callback_id, "Действие отменено")
        clear_callback_keyboard(callback)
        send_message("Действие отменено.", keyboard())
    elif data.startswith("confirm:"):
        action = data.removeprefix("confirm:")
        allowed_actions = {"deploy:prod", "admin:deploy:prod", "admin:rollback:prod"}
        if action not in allowed_actions:
            answer_callback(callback_id, "Неизвестное действие")
            return
        answer_callback(callback_id, "Подтверждение принято")
        clear_callback_keyboard(callback)
        if action == "deploy:prod":
            handle_deploy("prod")
        elif action == "admin:deploy:prod":
            handle_admin_deploy()
        else:
            handle_admin_rollback()


def get_updates(offset: int) -> list[dict[str, Any]]:
    poll_timeout = 50
    fields = {
        "timeout": str(poll_timeout),
        "offset": str(offset),
        "allowed_updates": json.dumps(["message", "callback_query"]),
    }
    return curl_api("getUpdates", fields, max_time=poll_timeout + 15).get("result", [])


def main() -> int:
    while True:
        try:
            configure_bot_ui()
            send_message("✅ Бот управления релизами запущен. Кнопки доступны над строкой ввода.", keyboard())
            break
        except Exception as exc:
            print(f"bot_init_error {type(exc).__name__}: {exc}", file=sys.stderr, flush=True)
            time.sleep(5)
    offset = 0
    while True:
        try:
            updates = get_updates(offset)
            for update in updates:
                offset = max(offset, int(update["update_id"]) + 1)
                handle_update(update)
        except subprocess.CalledProcessError as exc:
            print(f"telegram_api_error exit={exc.returncode} output={exc.output}", file=sys.stderr, flush=True)
            time.sleep(5)
        except Exception as exc:
            print(f"bot_error {type(exc).__name__}: {exc}", file=sys.stderr, flush=True)
            time.sleep(5)


if __name__ == "__main__":
    raise SystemExit(main())
