def confirmation_keyboard(action: str) -> dict[str, Any]:
    return {
        "inline_keyboard": [
            [
                {"text": "✅ Подтвердить", "callback_data": f"confirm:{action}"},
                {"text": "❌ Отмена", "callback_data": "confirm:cancel"},
            ],
        ]
    }


def clear_callback_keyboard(callback: dict[str, Any]) -> None:
    message = callback.get("message") or {}
    chat = message.get("chat") or {}
    if not chat.get("id") or not message.get("message_id"):
        return
    try:
        curl_api(
            "editMessageReplyMarkup",
            {
                "chat_id": str(chat["id"]),
                "message_id": str(message["message_id"]),
                "reply_markup": {"inline_keyboard": []},
            },
        )
    except Exception as exc:
        # The action remains safe even if Telegram can no longer edit an old
        # confirmation message. Log the UI cleanup problem and continue.
        print(f"callback_cleanup_error {type(exc).__name__}: {exc}", file=sys.stderr, flush=True)


